# Secrets - never commit real keys
keys/*.txt
!keys/README.txt
# Python
__pycache__/
*.pyc
*.pyo
# User-specific runtime data
app/data/settings.json
app/data/logs/*.log
# Local updater state
app/data/update-state.json
# v1.4.0: WhatsApp sidecar - installed by CI (npm ci), never committed
app/whatsapp_sidecar/node_modules/
app/whatsapp_sidecar/node/
# v1.4.0: WhatsApp session (Signal keys) - local only, NEVER committed
app/data/whatsapp_auth/

# v1.6.2: downloaded-update record - runtime state, never committed
app/data/update_downloaded.json
# v1.6.4-rc.3: habit store (private usage data) + pre-mode settings
# snapshot - runtime state, never committed
app/data/habits.json
app/data/mode_previous.json
